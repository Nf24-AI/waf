# ---------------------------------------------------------------------------
# Supabase — accounts and tasks. All four are required.
# ---------------------------------------------------------------------------
# Server side: the API calls Supabase with the signed-in user's token.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Browser side: sign-in itself. Same two values; the anon key is public by design.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Notion — the meetings database. Both values are required for meetings.
# ---------------------------------------------------------------------------
# Internal integration secret from notion.so/my-integrations (starts with ntn_)
NOTION_API_TOKEN=
# 32-character id of the meetings database
NOTION_DATABASE_ID=
# Only needed once, to run `pnpm setup:notion` and create the database
NOTION_PARENT_PAGE_ID=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
