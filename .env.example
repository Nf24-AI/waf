# ---------------------------------------------------------------------------
# Notion — this is the database. Both values are required.
# ---------------------------------------------------------------------------
# Internal integration secret from notion.so/my-integrations (starts with ntn_)
NOTION_API_TOKEN=
# 32-character id of the Meeting Prep database
NOTION_DATABASE_ID=
# Only needed once, to run `pnpm setup:notion` and create the database
NOTION_PARENT_PAGE_ID=

# ---------------------------------------------------------------------------
# Access — single user
# ---------------------------------------------------------------------------
# Empty = no gate. Safe for localhost only.
# REQUIRED before deploying to any public URL, or anyone with the address
# can read and edit your meetings.
APP_PASSWORD=
# Signs the session cookie. Any long random string.
JWT_SECRET=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Optional app branding
VITE_APP_TITLE=
VITE_APP_LOGO=
